# ==============================================================================
# AgentCraft Environment Configuration Template
# Copy this file to .env and configure your values.
# Do NOT commit .env with real secrets to version control.
# ==============================================================================

# Application Environment (development | staging | production | test)
AGENTCRAFT_ENV=development

# Backend Host & Port
AGENTCRAFT_HOST=127.0.0.1
AGENTCRAFT_PORT=8000
AGENTCRAFT_DEBUG=true

# Agent Execution Engine (hybrid | deterministic | openai | gemini | anthropic)
# Default is 'hybrid': runs deterministic plan-and-solve when API keys are not set,
# or seamlessly leverages LLM when keys are provided.
AGENTCRAFT_EXECUTION_MODE=hybrid

# LLM Providers (Optional for offline/hybrid mode, required for full live LLM generation)
# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Anthropic Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Security & Sandboxing
AGENTCRAFT_SANDBOX_DIR=./temp_sandbox
AGENTCRAFT_ARTIFACTS_DIR=./agent_artifacts
AGENTCRAFT_MAX_STEPS_PER_RUN=15
AGENTCRAFT_TOOL_TIMEOUT_SECONDS=30
AGENTCRAFT_ALLOW_NETWORK_FETCH=true

# Frontend Configuration (for Vite)
VITE_API_BASE_URL=http://localhost:8000

# ==============================================================================
# RakshaGrid — Disaster Intelligence & Response Configuration
# ==============================================================================
RAKSHAGRID_ENV=development
RAKSHAGRID_DEMO_MODE=true
RAKSHAGRID_DEFCON_LEVEL=2
RAKSHAGRID_ALERT_THRESHOLD=MODERATE

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rakshagrid
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Optional full connection URI override (defaults to postgresql+psycopg://...):
# DATABASE_URL=postgresql+psycopg://postgres:secret@localhost:5432/rakshagrid

# Phase 2: Authentication & Operational Security
RAKSHAGRID_DEV_AUTH_ENABLED=true
RAKSHAGRID_AUTH_SECRET_KEY=
RAKSHAGRID_PAGINATION_MAX_PAGE_SIZE=100
RAKSHAGRID_AUTO_MIGRATE=false

# Phase 4: External Disaster Data Integrations & Intelligence
# Open-Meteo provides free authoritative weather & river flood APIs (no API key required)
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_FLOOD_URL=https://flood-api.open-meteo.com/v1/flood
DISASTER_DATA_CACHE_TTL_SECONDS=900

